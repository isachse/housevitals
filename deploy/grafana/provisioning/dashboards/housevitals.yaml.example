# Template: copy to housevitals.yaml, replacing __PROJECT_DIR__ (see README, "Grafana dashboard").
apiVersion: 1
providers:
  - name: housevitals
    folder: Haus
    type: file
    allowUiUpdates: false   # the dashboard is generated by tools/build_grafana_dashboard.py
    updateIntervalSeconds: 30
    options:
      path: __PROJECT_DIR__/deploy/grafana/dashboards
